		sourceColumn: AssetCategory

		annotation SummarizationSetBy = Automatic

	column EffectiveTo
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7619a1c5-51db-40e8-b123-b53a451b2484
		summarizeBy: none
		sourceColumn: EffectiveTo

		variation Variation
			isDefault
			relationship: 488d0893-2c51-41a7-a0d5-659bf8813532
			defaultHierarchy: LocalDateTable_5c1d33c1-6a0d-41c8-9805-bcaa4592ce96.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column EffectiveFrom =
			
			VAR assetID = 'Assets'[AssetID]
			VAR currentEffectiveDate = 'Assets'[EffectiveTo]
			VAR prevEffectiveDate = MAXX(
			    FILTER(
			        'Assets',
			        AND (
			            [AssetID] = assetID,
			            [EffectiveTo] < currentEffectiveDate
			        )
			    ),
			    'Assets'[EffectiveTo]
			)
			RETURN IF(prevEffectiveDate = BLANK(), DATE(1900, 1, 1), prevEffectiveDate + 1)
		dataType: dateTime
		formatString: Short Date
		lineageTag: 8cd0b9ac-bdde-4ec1-b121-9c00cd3307e3
		summarizeBy: none
		isDataTypeInferred

		variation Variation
			isDefault
			relationship: b53971aa-2546-4758-afae-410a5f17531a
			defaultHierarchy: LocalDateTable_8def90ec-8ed6-45d1-91ce-cabbcc786e68.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Value
		dataType: int64
		formatString: 0
		lineageTag: 037f8912-903d-48c9-887c-b1c32ea2a730
		summarizeBy: sum
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

