table Assets
	lineageTag: 6119cd52-e2fc-44ad-a2e3-fd0d15da0c89

	measure 'Is Current' =
			
			VAR assetId = SELECTEDVALUE(Assets[AssetID])
			VAR effectiveDate = [Latest Effective Date]
			RETURN COUNTROWS(FILTER(Assets, AND('Assets'[EffectiveTo] = effectiveDate, Assets[AssetID] = assetId)))
		formatString: 0
		lineageTag: 9a5e6be2-4bb8-460f-9f95-4257b8e48f1e

	measure 'Latest Effective Date' =
			
			VAR assetId = SELECTEDVALUE(Assets[AssetID])
			RETURN CALCULATE(MIN(Assets[EffectiveTo]), REMOVEFILTERS(Assets), Assets[AssetID] = assetId, Assets[EffectiveTo] > MAX(Dates[Date]))
		formatString: Short Date
		lineageTag: d72cab55-5107-41ab-a2e2-839d2731de1e

	measure 'Latest Available Date' = MAX(Dates[Date])
		formatString: Short Date
		lineageTag: 39050b67-aa37-4f97-8c4c-3a0f862f6605

	measure 'Daily Value (Individual Asset)' =
			IF(
			    AND(
			        HASONEVALUE(Dates[Date]),
			        HASONEVALUE('Assets'[AssetID])
			    ),
			    CALCULATE(
			        SUM('Assets'[Value]),
			        'Assets'[EffectiveFrom] <= SELECTEDVALUE(Dates[Date]),
			        'Assets'[EffectiveTo] >= SELECTEDVALUE(Dates[Date])
			    )
			)
		formatString: 0
		lineageTag: 1c14dc41-98fd-4c36-8bbb-c8929ecff9fa

	measure 'Aggregated Value' = ```
			SUMX(
			    SUMMARIZE('Assets', 'Assets'[AssetID]), 
			    AVERAGEX(
			        'Dates',
			        [Daily Value (Individual Asset)]
			    )
			)
			// Daily average per asset, summed across assets
			```
		lineageTag: 23c855be-c215-4928-b288-bb2831fb82e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Is Current Category' =
			
			VAR assetId = SELECTEDVALUE(Assets[AssetID])
			VAR effectiveDate = [Latest Effective Date]
			VAR currentCategory = CALCULATE(MAX('Assets'[AssetCategory]), REMOVEFILTERS(Assets), AND('Assets'[EffectiveTo] = effectiveDate, Assets[AssetID] = assetId))
			RETURN COUNTROWS(FILTER(Assets, AND('Assets'[AssetCategory] = currentCategory, Assets[AssetID] = assetId)))
		formatString: 0
		lineageTag: 169c59c2-0e6b-435e-be8c-0038f276e286

